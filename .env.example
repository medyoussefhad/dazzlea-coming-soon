# ---- MongoDB ----
# Full connection string from MongoDB Atlas, password URL-encoded if it contains special chars.
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0"
# Database name used by the app.
MONGODB_DB="dazzlea"

# ---- Email notifications (Resend) ----
# API key from https://resend.com (starts with re_). Leave empty to disable email.
RESEND_API_KEY=""
# Verified sender. Use onboarding@resend.dev until dazzlea.agency is verified in Resend.
CONTACT_FROM="Dazzlea <onboarding@resend.dev>"
# Where new-lead notifications are sent.
CONTACT_TO="contact@dazzlea.agency"

# ---- Admin dashboard ----
# Password for the /admin page.
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie (any long random string).
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
